# Application
APP_NAME=Multi-DB Masking & Performance Overhead Monitor
APP_VERSION=5.0.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./local_monitor.db

# PostgreSQL (external connections)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=masking_monitor

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=mysql

# SQL Server
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=StrongPassword123!
MSSQL_DB=master

# SQLite
SQLITE_DB_PATH=local_monitor.db

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:5500"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Fernet Key
FERNET_KEY_PATH=.keyfile
